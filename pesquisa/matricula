#include <iostream>
#include <string>
using namespace std;

struct dado
{
  string nome;
  string curso;
  int mat;
};

// Função de busca sequencial por nome
int sequencial(dado vetor[], int tamanho, string x)
{
    for (int i = 0; i < tamanho; i++) {
        if (vetor[i].nome == x) {
            return i;  // Retorna a posição onde encontrou o aluno
        }
    }
    return -1; // Retorna -1 se não encontrar
}

int main()
{
    dado alunos[10000];
    int n; // Quantidade de alunos
    int i = 0;
    int pos;

    cin >> n;
    cin.ignore();  // Limpa o \n após a leitura de n
    
    // Leitura dos dados dos alunos
    for(i = 0; i < n; i++)
    {
        getline(cin, alunos[i].nome);  // Leitura do nome
        getline(cin, alunos[i].curso); // Leitura do curso
        cin >> alunos[i].mat;          // Leitura da matrícula
        cin.ignore();  // Limpa o \n após a leitura da matrícula
    }
    
    string nomebusca;
    getline(cin, nomebusca);  // Leitura do nome a ser buscado

    // Chama a função de busca
    pos = sequencial(alunos, n, nomebusca);
    
    if (pos != -1)
    {
        // Se o aluno foi encontrado, imprime os dados
        cout << alunos[pos].nome << endl;
        cout << alunos[pos].curso << endl;
        cout << alunos[pos].mat << endl;
    }
    else 
    {
        // Se o aluno não foi encontrado
        cout << "Aluno nao localizado" << endl;
    }
    
    return 0;
}
