#include <iostream>
using namespace std;

void insercaoDireta(int vetor[], int tamanho)
{
    int i, j; //contadores
    int chave;
    
    for(j=1; j<tamanho; j++)
    {
        chave = vetor[j];
        i = j - 1;
        
        while((i >= 0) && (vetor[i] < chave)) //ordem decrescente ---- para fazer onrdem crencente é vetor[i] > chave
        {
            vetor[i+1] = vetor[i];
            i = i - 1;
        }
        vetor[i + 1] = chave;
    }
}

int main()
{
    int vetor[1000];
    int n = 0;
    int num;

    // Lê os números até encontrar 0 (que não é inserido no vetor)
    while (cin >> num && num != 0) 
    {
        vetor[n] = num;
        n++;
    }

    // Ordena o vetor em ordem decrescente
    insercaoDireta(vetor, n);

    // Imprime o vetor ordenado
    for (int i = 0; i < n; i++)
    {
        cout << vetor[i] << " ";
       
    }
    
    return 0;
}
