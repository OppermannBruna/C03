
#include <iostream>
using namespace std;

//função de busca binaria
int binaria (int vetor[], int tamanho, int x)
{
    bool achou; // var para auxiliar busca
    int baixo, meio, alto; //var aux
    
    baixo = 0;
    alto = tamanho - 1;
    achou = false;
    
    while ((baixo <= alto) && (achou == false))
    {
        meio = (baixo + alto)/2;
        
        if (x < vetor[meio])
        alto = meio - 1;
        
        else if ( x > vetor[meio])
        {
            baixo = meio + 1;
        }
        
        else 
        achou = true;
    }
    
    if (achou)
        return meio;
    
    else 
        return -1;
}

int main()
{
    int ids[20]; //armazena os ids autorizados
    int valor; //var q armazena o id lido
    int i=0;
    
    //le os ids ate encontrar -1
    while(true)
    {
        cin >> valor; //valor de entrada

        if(valor == -1)
            break;

        ids[i] = valor; //armazena o valor lido no vetor
        i++;
    }
    
    int idver; //id que vai ser verificado 
    cin >> idver;
    
    int ver; // var p verifivar se tem acesso
    
    ver = binaria(ids, i, idver);
    
    if (ver != -1)
    cout << "Possui acesso" << endl;
    
    else 
    cout << "Nao possui acesso" << endl;
    
    return 0;
}
