#include <iostream>
using namespace std;

//estrutura para posição da tabela hash
struct dado
{
    int k; //chave
    int status; // vazio=0, ocupado=1
};

int hash_aux(int k, int m)
 {
    int result = k % m;
    if (result < 0) 
        result += m;
    
    return result;
}

int hash1(int k, int i, int m)
 {
    return (hash_aux(k, m) + i) % m;
}

int hash_insert(dado t[], int m, int k)
{
    int i = 0;
    do
    {
        int j = hash1 (k, i, m);
        if (t[j].status != 1){
            t[j].k = k;
            t[j].status = 1;
            return j; // posição q vai ficar na tabela
            }
        else 
            i = i +1;
    }while (i!=m);
    return -1;
}

int hash_search(dado t[], int m, int k)
{
    int i = 0;
    int j;
    do
    {
        j = hash1(k, i, m);
        if(t[j].k == k)
            return j;
        i = i + 1;
    }while(t[j].status != 0 && i<m);
        return -1;
    
}


int main()
{
    int i;
    int m;
    dado t[100];
    int chave;
    
    cin >> m;
    
    //iniciando a tabela
    for(i=0; i<m ; i++)
    {
        t[i].k = -1;
        t[i].status = 0;
    }
    
    //inserindo valores na tabela
    for (i=0; i<m; i++)
    {
        int k;
        cin >> k;
        
        if(k==0)
            break;
        int j = hash_insert(t, m, k);
    }
    
    cin >> chave;
    
    
    if(hash_search(t, m, chave) == -1)
    {
        cout << "Chave " << chave << " nao encontrada";
    }
    else 
        cout << "Chave " << chave << " encontrada na posicao " <<  hash_search(t, m, chave);
    
    return 0;
}
