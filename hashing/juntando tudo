#include <iostream>
using namespace std;

//estrutura para posição da tabela hash
struct dado
{
    int k; //chave
    int status; // 0=vazio, 1=ocupado
};

int h1(int k, int m)
 {
    int result = k % m;
     
    if (result < 0) 
        result += m;
    
    return result;
}

int h2(int k, int m)
{
    int result =  1 + (k % (m -1));
    
    if(result < 0)
        result += m;
    
    return result; 
}

int dhash(int k, int m, int i)
{
    return (h1(k, m) + i*h2(k,m)) % m;
}

//inserir
int hash_insert(dado t[], int m, int k)
{
    int i = 0;
    do
    {
        int j = dhash (k, m, i);
        if (t[j].status != 1){
            t[j].k = k;
            t[j].status = 1;
            return j; // posição q vai ficar na tabela
            }
        else 
            i = i +1;
    }while (i!=m);
    return -1;
}

//pesquisar
int hash_search(dado t[], int m, int k)
{
    int i = 0;
    int j;
    do
    {
        j = dhash(k, m, i);
        if (t[j].status == 1 && t[j].k == k)
            return j;
;
        i = i + 1;
    }while(t[j].status != 0 && i<m);
        return -1;

}

//remover
int hash_remove (dado t[], int m, int k)
{
    int j;
    j = hash_search(t, m, k);
    if(j != -1)
    {
        t[j].status = 2;
        t[j].k = -1;
        return 0; // consegui remover
    }
    else 
        return -1; // k nao esta na tabela
}

int main()
{
    int i;
    int m;
    dado t[100];
    int k;
    
    cin >> m;
    
    //iniciando a tabela
    for(i=0; i<m ; i++)
    {
        t[i].k = -1;
        t[i].status = 0;
    }
    
    int opcao;
    while(true)
    {
        cin >> opcao;
    
    if(opcao == 1) //inserir
    {
        cin >> k;
        hash_insert(t, m, k);
    }
    
    else if(opcao == 2) //pesquisar
    {
        cin >> k;
        int j = hash_search(t, m, k);
        cout << j << endl;
    }
    
    else if(opcao == 3) //remover
    {
        cin >> k;
        hash_remove(t, m, k);
    }
    
    else if(opcao == 4) //listar 
    {
        for(i=0; i<m; i++)
        {
            cout << t[i].k << " ";
        }
        cout << endl;
    }
    
    else if(opcao == 5) //sair
        break;
    }
    
    return 0;
}
