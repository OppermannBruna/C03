#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

struct info
{
    string nome;
    int idade;
    float peso;
    float altura;
};

//estrutura para posição da tabela hash
struct dado
{
    int k; //chave
    int status; // 0=vazio, 1=ocupado, 2=removido
    info atleta;
};

int h1(int k, int m)
 {
    int result = k % m;
     
    if (result < 0) 
        result += m;
    
    return result;
}

int h2(int k, int m)
{
    int result =  1 + (k % (m -1));
    
    if(result < 0)
        result += m;
    
    return result; 
}

int dhash(int k, int m, int i)
{
    return (h1(k, m) + i*h2(k,m)) % m;
}

//inserir
int hash_insert(dado t[], int m, int k)
{
    int i = 0;
    do
    {
        int j = dhash (k, m, i);
        if (t[j].status != 1){
            t[j].k = k;
            t[j].status = 1;
            return j; // posição q vai ficar na tabela
            }
        else 
            i = i +1;
    }while (i!=m);
    return -1;
}

//pesquisar
int hash_search(dado t[], int m, int k)
{
    int i = 0;
    int j;
    do
    {
        j = dhash(k, m, i);
        if (t[j].status == 1 && t[j].k == k)
            return j;
;
        i = i + 1;
    }while(t[j].status != 0 && i<m);
        return -1;

}

//remover
int hash_remove (dado t[], int m, int k)
{
    int j;
    j = hash_search(t, m, k);
    if(j != -1)
    {
        t[j].status = 2;
        t[j].k = -1;
        return 0; // consegui remover
    }
    else 
        return -1; // k nao esta na tabela
}

