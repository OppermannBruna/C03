#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

float raiz(float x, float xo, float e)
{
    if(abs((xo * xo) - x) <= e) {
        return xo;
	}
        
    else {
    	float aux = (xo * xo + x)/(2 * xo);
        return raiz(x, aux, e);
	}
}

int main()
{
    float x, xo, e;     
    
    cin >> x >> xo >> e;
    
    cout << fixed << setprecision(4);
    cout << raiz(x, xo, e) << endl;
    
    return 0;
}
